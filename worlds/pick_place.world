<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="pick_place_world">
    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <!-- Table: a 0.1 m tall box. Its TOP surface is at z = 0.10 -->
    <!-- (pose z = 0.05 is the box center, +/- 0.05 half-height).  -->
    <model name="table">
      <static>true</static>
      <pose>0.45 0 0.05 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.5 0.8 0.1</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.5 0.8 0.1</size></box></geometry>
          <material><ambient>0.6 0.4 0.2 1</ambient><diffuse>0.6 0.4 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Graspable red box (0.04 cube). Rest it ON the table: table top -->
    <!-- is z=0.10, half the cube is 0.02, so center z = 0.12. This way -->
    <!-- it sits still instead of falling. -->
    <model name="target_object">
      <pose>0.45 0.15 0.12 0 0 0</pose>
      <link name="link">
        <inertial>
          <mass>0.05</mass>
          <inertia><ixx>1e-5</ixx><iyy>1e-5</iyy><izz>1e-5</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
        </inertial>
        <collision name="c">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="v">
          <geometry><box><size>0.04 0.04 0.04</size></box></geometry>
          <material><ambient>1 0 0 1</ambient><diffuse>1 0 0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Drop location marker (green pad on the table, no collision). -->
    <model name="drop_marker">
      <static>true</static>
      <pose>0.45 -0.2 0.101 0 0 0</pose>
      <link name="link">
        <visual name="v">
          <geometry><box><size>0.1 0.1 0.002</size></box></geometry>
          <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
