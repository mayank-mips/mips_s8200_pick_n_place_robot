<?xml version="1.0"?>
<robot name="fanuc_pick_place" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================= -->
  <!-- Top-level model: Fanuc arm (from robot_digital_twin) + fixed   -->
  <!-- overhead depth camera + suction tip.                           -->
  <!--                                                                -->
  <!-- IMPORTANT: robot_digital_twin/urdf/fanuc_arm.xacro already     -->
  <!-- INSTANTIATES the arm (it calls <xacro:fanuc_lrmate200id7l/> at -->
  <!-- the bottom of the file) AND registers its own                  -->
  <!-- gazebo_ros_control plugin + a wrist camera. So we only INCLUDE -->
  <!-- it once here (that single include spawns the whole arm) and    -->
  <!-- then add our extra links. We must NOT wrap it in another macro -->
  <!-- or include it twice (that was causing two arms).               -->
  <!-- ============================================================= -->

  <xacro:include filename="$(find robot_digital_twin)/urdf/fanuc_arm.xacro"/>
  <xacro:include filename="$(find mips_pick_n_place)/urdf/depth_camera.xacro"/>
  <xacro:include filename="$(find mips_pick_n_place)/urdf/suction_tip.xacro"/>

  <!-- Fixed overhead (eye-to-hand) depth camera on a stand ~1.3 m     -->
  <!-- above the table, looking straight DOWN at the workspace.        -->
  <!-- Parent to 'world' (the base model's root link) so it stays put. -->
  <!-- rpy pitches the camera to point its +x (optical forward) down.  -->
  <xacro:depth_camera parent="world" xyz="0.45 0.0 1.3" rpy="0 1.5708 0"/>

  <!-- Suction tip attached to the arm flange (link_6 is the real last -->
  <!-- link in fanuc_arm.xacro). -->
  <xacro:suction_tip parent="link_6"/>

</robot>
