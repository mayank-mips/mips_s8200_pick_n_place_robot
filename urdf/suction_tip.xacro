<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- A simple suction tip attached to the arm's last link (link_6 / tool0). -->
  <!-- The vacuum grasp plugin attaches a contacting object to this link. -->

  <xacro:macro name="suction_tip" params="parent">
    <link name="suction_tip">
      <visual>
        <geometry><cylinder radius="0.015" length="0.04"/></geometry>
        <material name="suction_black"><color rgba="0.1 0.1 0.1 1"/></material>
      </visual>
      <collision>
        <geometry><cylinder radius="0.015" length="0.04"/></geometry>
      </collision>
      <inertial>
        <mass value="0.05"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
      </inertial>
    </link>

    <joint name="suction_tip_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="suction_tip"/>
      <!-- mount the tip pointing out along the tool's z axis -->
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
    </joint>

    <!-- gazebo_grasp_plugin: attaches contacting link rigidly to the gripper. -->
    <!-- Requires JenniferBuehler/gazebo-pkgs (see README). The plugin arm/palm -->
    <!-- link is 'suction_tip'; the gripper_link list is the contact link(s). -->
    <gazebo>
      <plugin name="gazebo_grasp_fix" filename="libgazebo_grasp_fix.so">
        <arm>
          <arm_name>fanuc_vacuum</arm_name>
          <palm_link>${parent}</palm_link>
          <gripper_link>suction_tip</gripper_link>
        </arm>
        <forces_angle_tolerance>100</forces_angle_tolerance>
        <update_rate>10</update_rate>
        <grip_count_threshold>1</grip_count_threshold>
        <max_grip_count>3</max_grip_count>
        <release_tolerance>0.005</release_tolerance>
        <disable_collisions_on_attach>false</disable_collisions_on_attach>
        <contact_topic>__default_topic__</contact_topic>
      </plugin>
    </gazebo>
  </xacro:macro>
</robot>
